# Copia este archivo como .env y rellena los valores reales.
# NUNCA comitas el .env al repositorio.

# Django
DJANGO_SECRET_KEY=django-insecure-replace-me-with-a-50-char-random-string
DJANGO_DEBUG=False

# Base de datos (PostgreSQL en producción)
# Formato: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://divinity:password@localhost:5432/divinity_db

# Desarrollo local (SQLite — omitir en producción)
# DATABASE_URL=sqlite:///db.sqlite3

# Email (opcional — sin configurar, los emails se imprimen en la consola del
# runserver). Funciona con cualquier proveedor SMTP: Gmail (usa una "App
# Password", no tu contraseña normal), SendGrid (smtp.sendgrid.net, user
# "apikey"), Resend (smtp.resend.com), Amazon SES, Mailgun, etc.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=tu-api-key-o-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@tudominio.com

# URL pública del frontend — se usa para armar links en emails (ej. invitación
# al portal del socio). En desarrollo local no hace falta tocarlo.
# FRONTEND_URL=https://app.tudominio.com
